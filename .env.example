# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables.
GROQ_API_KEY=

# Optional overrides (defaults shown)
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_CHAT_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=troy
# TTS_PROVIDER=groq        # set to "browser" to always use the browser's built-in voice
# RATE_LIMIT_PER_HOUR=60
